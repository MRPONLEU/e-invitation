rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /templates/{templateId} {
      allow read, write: if true;
    }

    match /musicTracks/{trackId} {
      allow read, write: if true;
    }

    match /couples/{coupleId} {
      allow read, write: if true;
    }
  }
}
